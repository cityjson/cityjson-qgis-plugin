# Example environment configuration for the CityJSON Loader plugin.
#
# Copy this file to `.env` and adjust the values to match your system:
#
#     cp example.env .env
#
# `.env` is git-ignored; this file documents the expected variables.

# Path to the QGIS Python interpreter (used by `make test`).
# Examples per platform:
#   macOS (QGIS cask):             /Applications/QGIS.app/Contents/MacOS/bin/python3
#   macOS (QGIS LTR cask):         /Applications/QGIS-LTR.app/Contents/MacOS/python
#   Linux:                         /usr/bin/python3
#   Windows:                       C:\Program Files\QGIS 3.xx\bin\python-qgis.bat
QGIS_PYTHON=/Applications/QGIS-LTR.app/Contents/MacOS/python

# QGIS profile directory, relative to HOME (used by `make deploy` to install
# the plugin locally). Defaults per platform:
#   macOS:   Library/Application Support/QGIS/QGIS3/profiles/default
#   Linux:   .local/share/QGIS/QGIS3/profiles/default
#   Windows: AppData\Roaming\QGIS\QGIS3\profiles\default
QGISDIR=Library/Application Support/QGIS/QGIS3/profiles/default

# Add the current directory to PYTHONPATH for module resolution.
PYTHONPATH=.

# QGIS debug and log settings (used by `make test`).
QGIS_DEBUG=0
QGIS_LOG_FILE=/dev/null
